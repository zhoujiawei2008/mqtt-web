# --- credentials and per-install state: never commit these ----------------- #
#
# The web panel writes its broker endpoint (including the MQTT password in
# plain text) and its account records next to itself. None of it belongs in a
# public repository.
mqtt-web-settings.json
mqtt-web-users.json
mqtt-web-vault.json
mqtt-web-devices.json
mqtt-web-devices.json.adopted
mqtt-web-cycle.json
mqtt-web-users/

# ... and neither do the .bak copies the tools keep of every one of them.
*.bak
*.bak.[0-9]*

# --- the example files under web/examples/ ARE meant to be committed -------- #
!web/examples/*.example.json

# --- python ---------------------------------------------------------------- #
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- editors and OS -------------------------------------------------------- #
.idea/
.vscode/
Thumbs.db
desktop.ini
*.swp

# --- local scratch --------------------------------------------------------- #
server-*/
certs/
